# Authentication
AUTH_SECRET="generate-a-secure-random-string"
ADMIN_EMAIL="admin@yourclinic.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Database
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/dentofacial?retryWrites=true&w=majority"

# Cloud Storage (Cloudinary)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"

# Email Configuration (Nodemailer)
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Site Information (for SEO and default links)
NEXT_PUBLIC_SITE_URL="https://yourclinic.com"
NEXT_PUBLIC_PHONE="+911234567890"
NEXT_PUBLIC_WHATSAPP="911234567890"
